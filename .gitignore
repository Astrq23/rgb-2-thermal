# Data & run artifacts (datasets live on Kaggle, never in git).
#
# Leading slashes matter: an unanchored `data/` also matches
# src/rgb2thermal/data/, which silently excluded the entire data layer from the
# repository. Anchor every project-root artifact to the root.
/data/
/outputs/
/predictions/
/checkpoints/
/runs/
/subset/
/manifest.csv

*.pt
*.pth
*.ckpt
*.npy
*.npz

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Secrets
kaggle.json
.env
